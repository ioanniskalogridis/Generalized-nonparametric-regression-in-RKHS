for(i in seq_along(lambda_grid)) {
lambda <- lambda_grid[i]
fit <- rkhs_quantile_fit(K, y, tau = tau, lambda = lambda)
alpha <- fit$alpha
fitted <- as.vector(K %*% alpha)
residuals <- y - fitted
train_loss <- mean(pmax(tau * residuals, (tau - 1) * residuals))
A <- K + n * lambda * diag(n)
df <- sum(diag(solve(A, K)))
penalty <- (1 - df / n)^2
gcv_scores[i] <- train_loss / max(penalty, 1e-8)
}
best_idx <- which.min(gcv_scores)
list(best_lambda = lambda_grid[best_idx],
gcv_scores = gcv_scores,
lambda_grid = lambda_grid)
}
# Main fitting function
fit_rkhs_quantile <- function(X, y, tau = 0.5, lambda = NULL,
kernel = "matern", length_scale = 1.0,
use_gcv = TRUE, lambda_grid = NULL) {
if (is.null(lambda) && use_gcv) {
if (is.null(lambda_grid)) lambda_grid <- 10^seq(-8, -2, length.out = 40)
gcv_res <- gcv_rkhs_quantile(X, y, tau, lambda_grid, kernel, length_scale)
lambda <- gcv_res$best_lambda
cat("GCV selected lambda =", format(lambda, scientific = TRUE), "\n")
}
X_train <- as.matrix(X)                    # Explicit name
n <- nrow(X_train)
# Compute training kernel
K_train <- if(kernel == "gaussian") {
gaussian_kernel(X_train, X_train, length_scale)
} else {
matern52_kernel(X_train, X_train, length_scale)
}
fit <- rkhs_quantile_fit(K_train, y, tau = tau, lambda = lambda)
alpha <- fit$alpha
# ==================== ROBUST PREDICTOR ====================
predictor <- function(X_new) {
X_new <- as.matrix(X_new)
if (ncol(X_new) != ncol(X_train)) {
stop(sprintf("X_new has %d columns, but training data has %d",
ncol(X_new), ncol(X_train)))
}
K_new <- if(kernel == "gaussian") {
gaussian_kernel(X_train, X_new, length_scale)
} else {
matern52_kernel(X_train, X_new, length_scale)
}
# Debug output
cat("Debug - K_new:", dim(K_new)[1], "x", dim(K_new)[2],
"| alpha length:", length(alpha), "\n")
as.vector(K_new %*% alpha)
}
list(alpha = alpha,
predictor = predictor,
fitted = as.vector(K_train %*% alpha),
lambda = lambda,
tau = tau,
kernel = kernel,
length_scale = length_scale,
X_train = X_train,          # store for safety
n_train = n)
}
