set.seed(123)
# ============================================================
# 1D TARGET GENERATOR
# ============================================================
generate_f0_1d <- function(beta, K = 50, p = 1.2) {
k <- 1:K
coeff <- k^(-(2 * beta + p))
f0 <- function(X) {
X <- as.matrix(X)
out <- rep(0, nrow(X))
for (j in 1:K) {
out <- out + coeff[j] * cos(2 * pi * j * X[,1])
}
out
}
list(f0 = f0, beta = beta)
}
